```gitignore
# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual Environment
venv/
.venv/
env/
ENV/

# Environment Variables
.env
.env.*

# IDEs
.vscode/
.idea/

# OS Files
.DS_Store
Thumbs.db

# Logs
*.log

# Pytest
.pytest_cache/
.coverage
htmlcov/

# MyPy
.mypy_cache/

# Ruff
.ruff_cache/

# Pyright
.pyright/

# Build
build/
dist/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# SQLite
*.db
*.sqlite3

# Alembic (optional)
# Uncomment if you don't want to track migration files
# alembic/versions/

# Misc
.python-version
```
